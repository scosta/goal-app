{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Debug Frontend (React)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}/client/src",
      "sourceMaps": true,
      "sourceMapPathOverrides": {
        "webpack:///src/*": "${webRoot}/*"
      }
    },
    {
      "name": "2. Debug Backend (Go)",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/server/cmd/api",
      "cwd": "${workspaceFolder}/server/cmd/api",
      "showLog": true,
      "env": {
        "FIRESTORE_PROJECT_ID": "test-project",
        "FIRESTORE_EMULATOR_HOST": "localhost:8081",
        "PUBSUB_EMULATOR_HOST": "localhost:8085"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "3. Debug Backend (Python)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/analytics/pubsub_consumer.py",
      "console": "integratedTerminal",
      "env": {
        "FIRESTORE_PROJECT_ID": "test-project",
        "PUBSUB_TOPIC": "goal-events",
        "PUBSUB_EMULATOR_HOST": "localhost:8085"
      },
      "cwd": "${workspaceFolder}/analytics",
      "python": "${workspaceFolder}/analytics/venv/bin/python"
    }
  ]
}